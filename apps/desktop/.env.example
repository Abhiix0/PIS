# Public, non-secret. Never put tokens or keys in VITE_* variables: they are bundled into the client.
VITE_API_BASE_URL=http://localhost:8000
# OIDC public-client settings (no secrets). Register redirect http://127.0.0.1/callback (loopback, any port) at the IdP.
VITE_AUTH_ISSUER=
VITE_AUTH_CLIENT_ID=
VITE_AUTH_AUDIENCE=
# Dev-only mock API (no backend/IdP needed; ignored by production builds). Also set the two AUTH vars below:
# VITE_MOCK_API=1  VITE_AUTH_ISSUER=http://mock.idp  VITE_AUTH_CLIENT_ID=mock
# URL flags: ?mock=empty|error|slow, #signed-out. Screenshots: npm run screenshots (docs/design/screens/)
