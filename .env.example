# Copy to .env and replace every placeholder. Never commit .env.
APP_ENV=local                      # local | test | staging | production
DATABASE_URL=postgresql://pis_user:<password>@localhost:5432/pis_db
POSTGRES_PASSWORD=<password>       # docker-compose db password (defaults to a local-dev value if unset)
GITHUB_TOKEN=                      # optional; raises GitHub API rate limits
LEETCODE_INTEGRATION_ENABLED=false # unofficial API, unverified terms (PRD 19#4); keep false until cleared
GITHUB_CALENDAR_ENABLED=false       # daily contribution calendar via GraphQL; needs GITHUB_TOKEN
GITHUB_CALENDAR_APPROVED=false      # staging/production refuse to start with CALENDAR_ENABLED=true unless this is also true (a human decision)
SYNC_COOLDOWN_SECONDS=300         # min gap between sync attempts per connection
AUTH_ISSUER=                       # OIDC issuer URL; required in staging/production (no value = every protected route returns 401)
AUTH_AUDIENCE=                     # API audience the IdP puts in tokens
AUTH_JWKS_URL=                     # IdP signing-key endpoint (RS256)
AUTH_ROLE_CLAIM=pis_roles          # list claim; value "pis_operator" grants operator rights
CORS_ALLOWED_ORIGINS=              # comma list; empty = no cross-origin access; '*' refused in staging/production. Desktop: http://tauri.localhost,tauri://localhost,http://localhost:1420
SEED_DEMO_DATA=true                # compose only; ignored/refused in staging/production
# TEST_ADMIN_DATABASE_URL=postgresql://<superuser>:<password>@localhost:5432/postgres   # enables DB integration tests
